{
  "schemaVersion": 1,
  "id": "retroconsole",
  "version": "${version}",
  "name": "RetroConsole",
  "description": "Retro console emulator in Minecraft",
  "authors": [
    "Gaigen"
  ],
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.retroconsole.fabric.RetroConsoleFabric"
    ],
    "client": [
      "com.retroconsole.fabric.client.RetroConsoleFabricClient"
    ]
  },
  "accessWidener": "retroconsole.classtweaker",
  "mixins": [
    "retroconsole.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
