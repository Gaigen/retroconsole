{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "tone",
    "cases": [
      {
        "when": "graphite",
        "model": {
          "type": "minecraft:model",
          "model": "retroconsole:block/console/fullblock/standby_graphite"
        }
      },
      {
        "when": "lavender",
        "model": {
          "type": "minecraft:model",
          "model": "retroconsole:block/console/fullblock/standby_lavender"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "retroconsole:item/retro_console"
    }
  }
}
